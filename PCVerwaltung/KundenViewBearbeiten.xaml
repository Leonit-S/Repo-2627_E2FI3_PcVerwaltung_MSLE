<UserControl x:Class="PCVerwaltung.KundenViewBearbeiten"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Width="1247" Height="906">
    <Grid Margin="8,8,76,37">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Left" Margin="-64,-32,0,0" TextWrapping="Wrap" Text="Kunde - Bearbeiten"  FontSize="20" Foreground="#673ab7" FontWeight="Bold" VerticalAlignment="Top" Height="34" Width="284"/>

        <!-- Buttons oben -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6">
            <Button x:Name="btnEdit" Margin="4" Content="Bearbeiten" Width="100" Click="OnEditClick"/>
            <Button x:Name="btnSave" Margin="4" Content="Speichern" Width="100" Click="OnSaveClick" Visibility="Collapsed"/>
            <Button x:Name="btnCancel" Margin="4" Content="Abbrechen" Width="100" Click="OnCancelClick" Visibility="Collapsed"/>
        </StackPanel>

        <!-- zwei Spalten: links DataGrid, rechts Formular -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tabelle (hat eigene Scrollbars) -->
            <DataGrid x:Name="dgCustomers" Grid.Column="0" ItemsSource="{Binding Customers}" Margin="0,4,4,4"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  MinHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="*"/>
                    <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="*"/>
                    <DataGridTextColumn Header="Ort" Binding="{Binding Ort}" Width="*"/>
                    <DataGridTextColumn Header="Straße" Binding="{Binding Strasse}" Width="*"/>
                    <DataGridTextColumn Header="Hausnummer" Binding="{Binding Hausnummer}" Width="*"/>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="*"/>
                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Formular rechts in eigenem ScrollViewer -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8" MaxHeight="600">
                <StackPanel x:Name="EditPanel" Orientation="Vertical">
                    <TextBlock Text="Vorname" Margin="0,4"/>
                    <TextBox x:Name="txtVornameEdit" />
                    <TextBlock Text="Nachname" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtNachnameEdit" />
                    <TextBlock Text="Straße" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtStrasseEdit" />
                    <TextBlock Text="Hausnummer" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtHausnummerEdit" />
                    <TextBlock Text="PLZ" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtPLZEdit" />
                    <TextBlock Text="Ort" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtOrtEdit" />
                    <TextBlock Text="Telefon" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtTelefonEdit" />
                    <TextBlock Text="E-Mail" Margin="0,6,0,2"/>
                    <TextBox x:Name="txtEmailEdit" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>